# Preserve delivered research bytes so SHA256SUMS survives a fresh checkout.
output/docx/research-program/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
output/pdf/research-program/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Publication files must retain their exact bytes across Windows and Linux.
*.pdf binary
*.epub binary
*.zip binary
